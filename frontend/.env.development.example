# [로컬 개발 환경변수 템플릿] 로컬 실행 시 .env.development 로 복사하여 사용합니다.

# Vite 프록시 목적지 주소 (로컬 대기열 플랫폼 백엔드)
VITE_PLATFORM_PROXY_TARGET=http://localhost:8082

# 브라우저 API 호출 베이스 경로 (Vite 프록시 활용)
VITE_API_BASE_URL=
VITE_AUTH_BASE_URL=

# 고객사 데모 바로가기 링크 (로컬)
VITE_DEMO_SERVER_URL=http://localhost:3030

# 그라파나 대시보드 주소 (로컬 Docker)
VITE_GRAFANA_BASE_URL=http://localhost:3000
VITE_GRAFANA_DASHBOARD_UID=adtwdpl
VITE_GRAFANA_DASHBOARD_SLUG=jvm-micrometer
