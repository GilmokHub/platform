# [배포용 환경변수 템플릿] GitHub Actions Secrets에서 빌드 시 자동 주입됩니다.
# 자체 백엔드 API는 Nginx 동일 오리진 상대 경로를 사용하므로 비워둡니다.
VITE_API_BASE_URL=
VITE_AUTH_BASE_URL=

# 고객사 데모 바로가기 링크 (VM 2)
VITE_DEMO_SERVER_URL=https://gilmok-demo.mywire.org

# 관측성 모니터링 Grafana 임베딩 주소 (VM 3)
VITE_GRAFANA_BASE_URL=https://gilmok-mon.mywire.org
VITE_GRAFANA_DASHBOARD_UID=adtwdpl
